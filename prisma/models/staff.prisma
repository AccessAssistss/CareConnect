// ##########----------Staff Profile Model----------##########
model Staff {
    id                String    @id @default(uuid())
    userId            String?   @unique
    companyId         String?
    name              String?   @db.VarChar(100)
    email             String?   @db.VarChar(100)
    mobile            String    @db.VarChar(10)
    gender            Gender?
    profilePhoto      String?   @db.VarChar(300)
    proficiency       String?   @db.VarChar(100)
    skillVerification String?   @db.VarChar(100)
    language          String?   @db.VarChar(100)
    fcmToken          String?   @db.VarChar(100)
    dob               DateTime?
    address           String?
    countryId         String?
    stateId           String?
    pincode           String?   @db.VarChar(100)
    otpExpiration     DateTime? @default(now())
    otp               String?   @db.VarChar(100)
    createdAt         DateTime  @default(now())
    updatedAt         DateTime  @updatedAt
    isDeleted         Boolean   @default(false)
    isExistingUser    Boolean   @default(false)

    user    CustomUser? @relation(fields: [userId], references: [id], onDelete: Cascade)
    country Country?    @relation(fields: [countryId], references: [id])
    state   State?      @relation(fields: [stateId], references: [id])
    company Company?    @relation(fields: [companyId], references: [id])

    booking       Booking[]
    staffDocument StaffDocument?
    staffSkill    StaffSkill[]
}

// ##########----------Staff Skills----------##########
model StaffSkill {
    id        String   @id @default(uuid())
    staffId   String
    skillId   String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    isDeleted Boolean  @default(false)

    staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
    skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)
}

// ##########----------Staff Document Model----------##########
model StaffDocument {
    id                    String   @id @default(uuid())
    staffId               String   @unique
    name                  String?  @db.VarChar(150)
    govtID                String?  @db.VarChar(300)
    certification         String?  @db.VarChar(300)
    govtIDVerified        Boolean  @default(false)
    certificationVerified Boolean  @default(false)
    createdAt             DateTime @default(now())
    updatedAt             DateTime @updatedAt
    isDeleted             Boolean  @default(false)

    staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)
}
