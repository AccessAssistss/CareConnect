// ##########----------Company Profile Model----------##########
model Company {
    id             String    @id @default(uuid())
    userId         String?   @unique
    companyName    String?   @db.VarChar(100)
    email          String?   @db.VarChar(100)
    mobile         String    @db.VarChar(10)
    companyLogo    String?   @db.VarChar(300)
    fcmToken       String?   @db.VarChar(100)
    address        String?
    countryId      String?
    stateId        String?
    pincode        String?   @db.VarChar(100)
    gst            String?   @db.VarChar(100)
    otpExpiration  DateTime? @default(now())
    otp            String?   @db.VarChar(100)
    isOnline       Boolean   @default(false)
    createdAt      DateTime  @default(now())
    updatedAt      DateTime  @updatedAt
    isDeleted      Boolean   @default(false)
    isExistingUser Boolean   @default(false)

    user    CustomUser? @relation(fields: [userId], references: [id], onDelete: Cascade)
    country Country?    @relation(fields: [countryId], references: [id])
    state   State?      @relation(fields: [stateId], references: [id])

    review Review[]
    staff  Staff[]
    wallet Wallet?
}

// ##########----------Company Service Model----------##########
model CompanyService {
    id          String   @id @default(uuid())
    companyId   String
    serviceId   String
    pricePerDay Float
    isActive    Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
    isDeleted   Boolean  @default(false)

    company CustomUser @relation(fields: [companyId], references: [id])
    service Service    @relation(fields: [serviceId], references: [id])

    bookingRequest BookingRequest[]
}
