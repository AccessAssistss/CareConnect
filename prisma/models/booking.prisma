// ##########----------Booking Request Model----------##########
model BookingRequest {
    id             String               @id @default(uuid())
    customerId     String
    familyMemberId String?
    providerSvcId  String?
    companySvcId   String?
    startDate      DateTime
    endDate        DateTime?
    totalAmount    Float
    status         BookingRequestStatus @default(PENDING)
    createdAt      DateTime             @default(now())
    updatedAt      DateTime             @updatedAt
    isDeleted      Boolean              @default(false)

    providerSvc  ProviderService? @relation(fields: [providerSvcId], references: [id], onDelete: Cascade)
    companySvc   CompanyService?  @relation(fields: [companySvcId], references: [id], onDelete: Cascade)
    customer     Customer?        @relation(fields: [customerId], references: [id], onDelete: Cascade)
    familyMember FamilyMember?    @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)

    bookings Booking[]
}

// ##########----------Booking Model----------##########
model Booking {
    id        String        @id @default(uuid())
    requestId String
    date      DateTime
    staffId   String?
    status    BookingStatus @default(PENDING)
    amount    Float
    createdAt DateTime      @default(now())
    updatedAt DateTime      @updatedAt
    isDeleted Boolean       @default(false)

    request BookingRequest @relation(fields: [requestId], references: [id])
    staff   Staff?         @relation(fields: [staffId], references: [id], onDelete: Cascade)
}
